<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js font-open-sans">
<head>
    {% render 'head-meta' %}
    <link rel="icon" href="{{ 'favicon.ico' | asset_url }}" sizes="any"/>
    <link rel="icon" href="{{ 'icon.svg' | asset_url }}" type="image/svg+xml"/>
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}"/>
    <link rel="manifest" href="{{ '/manifest.webmanifest' | asset_url }}"/>
    <meta name="apple-mobile-web-app-title" content="VAST"/>

    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.shopify.com">
    <link rel="preload" href="{{ 'ZalandoSans.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>

    {% render 'font-face' %}

    <title>
        {{ page_title }}
        {%- if current_tags %}
            &ndash; tagged "{{ current_tags | join: ', ' }}"{%- endif -%}
        {%- if current_page != 1 %}
            &ndash; Page {{ current_page -}}{%- endif -%}
        {%- unless page_title contains shop.name %}
            &ndash; {{ shop.name -}}{%- endunless -%}
    </title>

    <!-- header hook for Shopify plugins -->
    {{ content_for_header }}

    {% render 'head-css' %}
    {% render 'head-scripts' %}

    {% liquid
        render 'vite' with 'theme.css'
        render 'vite' with 'theme.js'
    %}

    {%- comment -%}Product page bundle{%- endcomment -%}
    {% if template contains 'product' %}
        {% render 'vite' with 'product.js' %}
    {% endif %}

    {%- comment -%}Collection/search bundle (excludes list-collections){%- endcomment -%}
    {% if template == 'collection' or template contains 'collection.' or template contains 'search' %}
        {% render 'vite' with 'collection.js' %}
    {% endif %}

    {%- comment -%}Blog/article bundle{%- endcomment -%}
    {% if template contains 'blog' or template contains 'article' %}
        {% render 'vite' with 'blog.js' %}
    {% endif %}
</head>

{% liquid
    assign bodyClasses = template | handleize | append: '-template'
    assign bodyClasses = bodyClasses | append: ' antialiased using-mouse'

    if settings.show_promo_bar
        assign bodyClasses = bodyClasses | append: ' promo-bar-visible'
    endif
%}

<body
        class="{{ bodyClasses }}"
        :class="$store.global.bodyClasses"
        x-data
        x-scrolled
>

<a class="skip-to-content-link" href="#main-content">
    Skip to content
</a>

{% section 'header' %}

<main
        id="main-content"
        role="main"
        class="site-main relative">
    {% if request.path contains '/policies/' %}
        {%- comment -%} Enhanced styling for policy pages {%- endcomment -%}
        <div class="px-6 md:px-8">
            <div class="container mx-auto py-12">
                <div class="prose max-w-4xl mx-auto">
                    {{ content_for_layout }}
                </div>
            </div>
        </div>
    {% else %}
        {{ content_for_layout }}
    {% endif %}
</main>

{% section 'footer' %}

{% comment %} Minicart backdrop overlay {% endcomment %}
<div
        x-data
        x-show="$store.global.isMinicartVisible"
        x-transition.opacity.duration.300ms
        class="fixed inset-0 bg-black/50 z-40"
        @click="$store.global.isMinicartVisible = false"
        x-cloak
        :aria-hidden="$store.global.isMinicartVisible ? 'false' : 'true'"
></div>

{% comment %} Minicart drawer wrapper {% endcomment %}
<div
        class="fixed z-50 right-8 top-8 w-sm"
        x-data
        x-show="$store.global.isMinicartVisible"
        x-transition:enter="transition-transform ease-out duration-300"
        x-transition:enter-start="translate-x-full"
        x-transition:enter-end="translate-x-8"
        x-transition:leave="transition-transform ease-in duration-300"
        x-transition:leave-start="translate-x-8"
        x-transition:leave-end="translate-x-full"
        x-cloak
        aria-modal="true"
        role="dialog"
        aria-labelledby="minicart-label"
        x-trap.inert.noscroll="$store.global.isMinicartVisible">
    {% section 'minicart' %}
</div>

{% if settings.enable_predictive_search %}
    {% section 'predictive-search-main' %}
{% endif %}

{% if settings.enable_modal %}
    {% section 'modal' %}
{% endif %}

{% render 'liquid-ajax-cart' %}
</body>
</html>